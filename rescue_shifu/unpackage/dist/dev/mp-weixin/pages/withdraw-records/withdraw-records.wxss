@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	padding: 32rpx;
	background: #F5F7FA;
	min-height: 100vh;
}
.card {
	background: #FFFFFF;
	border-radius: 20rpx;
	padding: 28rpx;
	border: 1rpx solid #E1E8ED;
}
.head {
	margin-bottom: 20rpx;
}
.title {
	font-size: 34rpx;
	font-weight: 700;
	color: #1D1D1F;
	display: block;
}
.subtitle {
	font-size: 24rpx;
	color: #8E8E93;
	display: block;
	margin-top: 8rpx;
}
.filter-row {
	display: flex;
	flex-direction: row;
	gap: 16rpx;
	margin-bottom: 24rpx;
}
.filter-item {
	padding: 10rpx 22rpx;
	border-radius: 999rpx;
	background: #F0F5F9;
	color: #666;
	font-size: 24rpx;
}
.filter-item.active {
	background: #007fff;
	color: #fff;
}
.empty {
	text-align: center;
	padding: 48rpx 0;
	font-size: 26rpx;
	color: #8E8E93;
}
.list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}
.row {
	border: 1rpx solid #EDF1F5;
	border-radius: 14rpx;
	padding: 20rpx;
}
.row-top,
.row-mid {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}
.row-mid {
	margin-top: 10rpx;
}
.apply-no {
	font-size: 24rpx;
	color: #333;
	max-width: 70%;
}
.amount {
	font-size: 30rpx;
	font-weight: 700;
	color: #1D1D1F;
}
.time {
	font-size: 22rpx;
	color: #8E8E93;
}
.status {
	font-size: 22rpx;
	font-weight: 600;
	padding: 6rpx 14rpx;
	border-radius: 999rpx;
}
.st-applying {
	background: #EBF3FF;
	color: #007fff;
}
.st-success {
	background: #E8F8EE;
	color: #1F9D55;
}
.st-failed {
	background: #FDECEC;
	color: #D93025;
}
.reason {
	display: block;
	margin-top: 10rpx;
	font-size: 22rpx;
	color: #D93025;
}
