<view id="{{w}}" change:eS="{{uV.sS}}" eS="{{$eS[w]}}" change:eA="{{uV.sA}}" eA="{{$eA[w]}}" class="{{['page', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="card"><view class="user-row"><image class="avatar" src="{{a}}" mode="aspectFill"></image><view class="user-info"><text class="name">{{b}}</text><text class="desc">{{c}}</text></view></view><view class="divider"></view><view wx:if="{{d}}" class="actions"><view class="protocol-section"><checkbox-group bindchange="{{f}}"><label class="agreement"><checkbox value="agree" checked="{{e}}"/></label><text>我已阅读并同意</text><navigator url="/pages/settings/settings" class="link">《用户服务协议》</navigator><text>和</text><navigator url="/pages/settings/settings" class="link">《隐私政策》</navigator></checkbox-group></view><button class="btn btn-primary" disabled="{{h}}" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="{{i}}" bindagreeprivacyauthorization="{{j}}">{{g}}</button></view><view wx:else class="actions"><button class="btn btn-plain" bindtap="{{k}}">退出登录</button></view></view><view class="wallet-card"><view class="wallet-header"><text class="wallet-title">钱包</text><text class="wallet-subtitle">满10元可提现</text></view><view class="wallet-balance-wrap"><text class="wallet-balance">￥{{l}}</text><text class="wallet-balance-desc">{{m}}</text><text wx:if="{{n}}" class="wallet-balance-desc">冻结中：￥{{o}}</text></view><view class="wallet-actions"><button class="{{['btn', q]}}" disabled="{{r}}" bindtap="{{s}}">{{p}}</button></view><view wx:if="{{t}}" class="reconcile-section"><view class="reconcile-head"><text class="reconcile-title">最近提现记录</text><navigator url="/pages/withdraw-records/withdraw-records" class="reconcile-more">查看全部</navigator></view><view wx:for="{{v}}" wx:for-item="item" wx:key="c" class="reconcile-row"><text class="reconcile-left">{{item.a}}</text><text class="reconcile-right">{{item.b}}</text></view></view></view></view><wxs src="/common/uniView.wxs"