@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

/* 基础布局 */
.page {
	padding: 40rpx;
	background-color: #F5F7FA;
	min-height: 100vh;
}

/* 卡片容器 */
.card {
	background: #FFFFFF;
	border-radius: 24rpx;
	padding: 48rpx;
	margin-bottom: 40rpx;
	box-shadow: 0 8rpx 32rpx rgba(0, 127, 255, 0.05);
	border: 1rpx solid #E1E8ED;
}
.section-title {
	font-size: 24rpx;
	font-weight: 600;
	color: #007fff;
	text-transform: uppercase;
	letter-spacing: 1.5rpx;
	display: block;
	margin-bottom: 40rpx;
}

/* 顶部状态 */
.top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 48rpx;
	padding-bottom: 32rpx;
	border-bottom: 1rpx solid #F0F5F9;
}
.order-no {
	font-size: 28rpx;
	color: #1D1D1F;
	font-weight: 600;
	font-family: ui-monospace, monospace;
}
.status {
	font-size: 22rpx;
	padding: 8rpx 20rpx;
	border-radius: 8rpx;
	font-weight: 600;
	letter-spacing: 1rpx;
}
.st-new {
	background: #FFF9E6;
	color: #ffbe0b;
}
.st-processing {
	background: #EBF3FF;
	color: #007fff;
}
.st-done {
	background: #E6F7ED;
	color: #2ecc71;
}

/* 信息行 */
.row {
	margin-top: 24rpx;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	gap: 24rpx;
}
.label {
	width: 140rpx;
	flex-shrink: 0;
	font-size: 24rpx;
	color: #86868B;
	letter-spacing: 0.5rpx;
}
.value {
	flex: 1;
	font-size: 28rpx;
	color: #1D1D1F;
	text-align: right;
	word-break: break-all;
	line-height: 1.5;
}
.link {
	color: #007fff;
	text-decoration: none;
	font-weight: 600;
}
.highlight-blue {
	color: #007fff;
	font-weight: 600;
}
.highlight-red {
	color: #fb5607;
	font-weight: 700;
	font-size: 32rpx;
}
.muted {
	color: #D1D1D6;
}
.divider {
	height: 1rpx;
	background: #F0F5F9;
	margin: 40rpx 0;
}

/* 底部操作 */
.actions {
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}
.btn {
	width: 100%;
	height: 96rpx;
	line-height: 96rpx;
	border-radius: 12rpx;
	font-size: 28rpx;
	font-weight: 600;
	margin: 0;
	transition: all 0.2s;
}
.btn-primary {
	background: #007fff;
	color: #FFFFFF;
	border: none;
	box-shadow: 0 8rpx 20rpx rgba(0, 127, 255, 0.2);
}
.btn-success {
	background: #007fff;
	color: #FFFFFF;
	border: none;
	box-shadow: none;
}
.btn-success:disabled {
	background: #AEAEB2;
	opacity: 0.6;
	box-shadow: none;
}
.btn-transfer {
	background: #FFFFFF;
	color: #fb5607;
	border: 1rpx solid #fb5607;
}
.btn-revoke-dispatch {
	background: #FFFFFF;
	color: #FF3B30;
	border: 1rpx solid #FF3B30;
}
.btn-plain {
	background: #FFFFFF;
	color: #007fff;
	border: 1rpx solid #007fff;
}
.btn:active {
	opacity: 0.8;
}

/* 师傅反馈板块样式 */
.feedback-content {
	margin-top: 20rpx;
}
.feedback-label {
	font-size: 24rpx;
	color: #86868B;
	margin-bottom: 24rpx;
	display: block;
}
.feedback-imgs {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 20rpx;
}
.feedback-img-wrap {
	position: relative;
	width: 150rpx;
	height: 150rpx;
}
.feedback-img {
	width: 100%;
	height: 100%;
	border-radius: 12rpx;
	background: #F5F7FA;
	border: 1rpx solid #E1E8ED;
}
.img-delete {
	position: absolute;
	top: -10rpx;
	right: -10rpx;
	width: 36rpx;
	height: 36rpx;
	background: #fb5607;
	border-radius: 18rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
}
.delete-icon {
	color: #FFFFFF;
	font-size: 24rpx;
	line-height: 1;
	font-weight: bold;
}
.upload-btn {
	width: 150rpx;
	height: 150rpx;
	background: #FFFFFF;
	border: 2rpx dashed #007fff;
	border-radius: 12rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.upload-icon {
	font-size: 48rpx;
	color: #007fff;
	margin-bottom: 4rpx;
}
.upload-text {
	font-size: 20rpx;
	color: #007fff;
	font-weight: 500;
}

/* 地图板块 */
.map {
	width: 100%;
	height: 480rpx;
	border-radius: 12rpx;
	overflow: hidden;
	background: #F5F7FA;
	border: 1rpx solid #E1E8ED;
}
.loc-grid {
	margin-top: 40rpx;
	display: flex;
	flex-direction: row;
	gap: 20rpx;
}
.loc-item {
	flex: 1;
	background: #F5F7FA;
	border-radius: 12rpx;
	padding: 24rpx;
	border: 1rpx solid #E1E8ED;
}
.loc-title {
	font-size: 20rpx;
	color: #007fff;
	text-transform: uppercase;
	letter-spacing: 1rpx;
	display: block;
	margin-bottom: 8rpx;
	font-weight: 600;
}
.loc-value {
	font-size: 24rpx;
	color: #1D1D1F;
	display: block;
	word-break: break-all;
}
.loc-sub {
	font-size: 22rpx;
	color: #86868B;
	display: block;
	margin-top: 8rpx;
	word-break: break-all;
	font-family: ui-monospace, monospace;
}
