<view id="{{O}}" change:eS="{{uV.sS}}" eS="{{$eS[O]}}" change:eA="{{uV.sA}}" eA="{{$eA[O]}}" class="{{['page', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="card"><text class="section-title">订单信息</text><view class="top"><text class="order-no">订单号：{{a}}</text><text class="{{['status', c]}}">{{b}}</text></view><view class="row"><text class="label">创建时间</text><text class="value">{{d}}</text></view><view class="row"><text class="label">服务类型</text><text class="value highlight-blue">{{e}}</text></view><view class="row"><text class="label">车牌号</text><text class="value">{{f}}</text></view><view class="row"><text class="label">联系电话</text><text class="value link highlight-blue" bindtap="{{h}}">{{g}}</text></view><view class="row"><text class="label">地址</text><text class="value link highlight-blue" bindtap="{{j}}">{{i}}</text></view><view class="row"><text class="label">备注</text><text class="{{['value', l && 'muted']}}">{{k}}</text></view><view class="row"><text class="label">订单金额</text><text class="value highlight-red">￥{{m}}</text></view><view wx:if="{{n}}" class="divider"></view><view wx:if="{{o}}" class="actions"><button class="btn btn-primary" bindtap="{{p}}">接单</button></view></view><view wx:if="{{q}}" class="card"><text class="section-title">师傅反馈</text><view wx:if="{{r}}" class="divider"></view><view wx:if="{{s}}" class="actions"><button wx:if="{{t}}" class="btn btn-success" disabled="{{w}}" bindtap="{{x}}">{{v}}</button><button wx:if="{{y}}" class="btn btn-transfer" bindtap="{{z}}">申请转派</button><button wx:if="{{A}}" class="btn btn-revoke-dispatch" bindtap="{{B}}">撤回派单</button></view></view><view class="card"><text class="section-title">位置地图</text><map id="orderMap" class="map" latitude="{{D}}" longitude="{{E}}" scale="{{14}}" markers="{{F}}" polyline="{{G}}" show-location="{{true}}" change:eS="{{uV.sS}}" eS="{{$eS[C]}}" change:eA="{{uV.sA}}" eA="{{$eA[C]}}"></map><view class="loc-grid"><view class="loc-item"><text class="loc-title">客户位置</text><text class="loc-value">{{H}}</text><text class="loc-sub">{{I}}, {{J}}</text></view><view class="loc-item"><text class="loc-title">我的位置</text><text class="loc-value">{{K}}</text><text class="loc-sub">{{L}}, {{M}}</text></view></view><view class="map-actions"><view class="divider"></view><button class="btn btn-plain" bindtap="{{N}}">导航到客户</button></view></view></view><wxs src="/common/uniView.wxs" module="uV"/>
