import { ref, reactive } from 'vue'

export type OrderStatus = 'new' | 'processing' | 'done'
export type DispatchStatus = 'none' | 'dispatched' | 'accepted'

export type MyOrder = {
	id : string
	orderNo : string
	createTime : number
	serviceType : string
	plateNo : string
	status : OrderStatus
	dispatchStatus : DispatchStatus
	dispatchToName : string
	orderPrice : number
	ratio?: number | null
	remark : string
	customerPhone : string
	customerName : string
	address : string
	lat : number
	lng : number
	agencyId : string
	agencyOrderType?: number
	masterId : string
	orderReceivingId : string
	images : string[]
	feedbackImages : string[]
	serverStatus ?: string
	isTransferPending ?: boolean
	transferReason ?: string
}

