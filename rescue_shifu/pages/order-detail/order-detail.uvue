<template>
	<view class="page">
		<!-- 订单信息板块 -->
		<view class="card">
			<text class="section-title">订单信息</text>
			<view class="top">
				<text class="order-no">订单号：{{ detail.orderNo }}</text>
				<text class="status" :class="statusClass(detail.status)">{{ statusText(detail.status) }}</text>
			</view>

			<view class="row">
				<text class="label">创建时间</text>
				<text class="value">{{ formatTime(detail.createTime) }}</text>
			</view>

			<view class="row">
				<text class="label">服务类型</text>
				<text class="value highlight-blue">{{ detail.serviceType }}</text>
			</view>

			<view class="row">
				<text class="label">车牌号</text>
				<text class="value">{{ detail.plateNo }}</text>
			</view>

			<view class="row">
				<text class="label">联系电话</text>
				<text class="value link highlight-blue" @click="callPhone(detail.customerPhone)">{{ detail.customerPhone }}</text>
			</view>

			<view class="row">
				<text class="label">地址</text>
				<text class="value link highlight-blue" @click="openCustomerMap">{{ customerAddress || detail.address || '-' }}</text>
			</view>

			<view class="row">
				<text class="label">备注</text>
				<text class="value" :class="{ muted: !detail.remark }">{{ detail.remark || '无' }}</text>
			</view>

			<view class="row">
				<text class="label">订单金额</text>
				<text class="value highlight-red">￥{{ displayAmount }}</text>
			</view>

			<view v-if="detail.status === 'new'" class="divider"></view>

			<view v-if="detail.status === 'new'" class="actions">
				<button class="btn btn-primary" @click="accept">接单</button>
			</view>
		</view>

		<!-- 师傅反馈板块 -->
		<view v-if="detail.status === 'processing' || detail.status === 'done'" class="card">
			<text class="section-title">师傅反馈</text>
			
			<view v-if="detail.status === 'processing'" class="divider"></view>
			
			<view v-if="detail.status === 'processing'" class="actions">
				<button v-if="(isMaster || isProvider) && actionLabel" class="btn btn-success" :disabled="actionDisabled" @click="onStatusActionClick">{{ actionLabel }}</button>
				<button v-if="isMaster" class="btn btn-transfer" @click="onApplyTransferClick">申请转派</button>
				<button v-if="isProvider && detail.dispatchStatus === 'dispatched'" class="btn btn-revoke-dispatch" @click="onRevokeDispatchClick">撤回派单</button>
			</view>
		</view>

		<!-- 位置地图板块 -->
		<view class="card">
			<text class="section-title">位置地图</text>

			<map
				id="orderMap"
				class="map"
				:latitude="mapCenterLat"
				:longitude="mapCenterLng"
				:scale="14"
				:markers="markers"
				:polyline="polyline"
				:show-location="true"
			></map>

			<view class="loc-grid">
				<view class="loc-item">
					<text class="loc-title">客户位置</text>
					<text class="loc-value">{{ customerAddress || detail.address || '定位中...' }}</text>
					<text class="loc-sub">{{ detail.lat }}, {{ detail.lng }}</text>
				</view>
				<view class="loc-item">
					<text class="loc-title">我的位置</text>
					<text class="loc-value">{{ masterAddress || '定位中...' }}</text>
					<text class="loc-sub">{{ masterLat }}, {{ masterLng }}</text>
				</view>
			</view>

			<view class="map-actions">
			    <view class="divider"></view>
				<button class="btn btn-plain" @click="openCustomerMap">导航到客户</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { globalOrders, currentUserId, type MyOrder, type OrderStatus } from '../../common/mockData.uts'
	import { acceptOrder, acceptDispatch, completeOrder, getDispatchPreview, getOrderDetail, MAP_CONFIG, revokeDispatch as revokeDispatchApi, updateOrderStatus } from '../../common/api.uts'

	const id = ref('')
	const sharerId = ref('')
	const dispatchRatio = ref<number | null>(null)
	const dispatchToken = ref('')
	const isFromDispatch = ref(false)
	const masterLat = ref(0)
	const masterLng = ref(0)
	const customerAddress = ref('')
	const masterAddress = ref('')

	const netPrice = ref<number | null>(null)
	const dispatchMasterIncomeAmount = ref<number | null>(null)

	const detail = ref<MyOrder>({
		id: '',
		orderNo: '-',
		createTime: Date.now(),
		serviceType: '-',
		remark: '',
		plateNo: '-',
		customerName: '-',
		customerPhone: '-',
		address: '-',
		orderPrice: 0,
		ratio: null,
		lat: 0,
		lng: 0,
		status: 'new',
		dispatchStatus: 'none',
		dispatchToName: '',
		agencyId: '',
		masterId: '',
		orderReceivingId: '',
		images: [],
		feedbackImages: [],
		serverStatus: ''
	})

	// 角色判定
	const isProvider = computed(() : boolean => detail.value.agencyId == currentUserId.value)
	const isMaster = computed(() : boolean => detail.value.masterId == currentUserId.value)

	const mapCenterLat = computed<number>(() => {
		if (detail.value.lat != 0) return detail.value.lat
		if (masterLat.value != 0) return masterLat.value
		return 0
	})
	const mapCenterLng = computed<number>(() => {
		if (detail.value.lng != 0) return detail.value.lng
		if (masterLng.value != 0) return masterLng.value
		return 0
	})

	const displayAmount = computed<string>(() => {
		if (dispatchMasterIncomeAmount.value != null) return Number(dispatchMasterIncomeAmount.value).toFixed(2)
		if (netPrice.value != null) return Number(netPrice.value).toFixed(2)
		if (!isFromDispatch.value) return detail.value.orderPrice.toFixed(2)
		const ratio = dispatchRatio.value != null ? dispatchRatio.value : (detail.value.ratio ?? 0)
		const finalAmount = detail.value.orderPrice * (1 - Number(ratio) / 100)
		return finalAmount.toFixed(2)
	})

	type MapMarker = {
		id: number
		latitude: number
		longitude: number
		title: string
		iconPath?: string
		width?: number
		height?: number
	}

	const markers = computed<MapMarker[]>(() => {
		const list: MapMarker[] = []
		if (detail.value.lat != 0 && detail.value.lng != 0) {
			list.push({ id: 1, latitude: detail.value.lat, longitude: detail.value.lng, title: '客户位置' } as MapMarker)
		}
		if (masterLat.value != 0 && masterLng.value != 0) {
			list.push({ id: 2, latitude: masterLat.value, longitude: masterLng.value, title: '我的位置' } as MapMarker)
		}
		return list
	})

	type MapPolylinePoint = { latitude: number; longitude: number }
	type MapPolyline = { points: MapPolylinePoint[]; color: string; width: number; dottedLine?: boolean }

	const polyline = computed<MapPolyline[]>(() => {
		if (detail.value.lat == 0 || detail.value.lng == 0) return []
		if (masterLat.value == 0 || masterLng.value == 0) return []
		return [
			{
				points: [
					{ latitude: masterLat.value, longitude: masterLng.value } as MapPolylinePoint,
					{ latitude: detail.value.lat, longitude: detail.value.lng } as MapPolylinePoint
				],
				color: '#007AFF',
				width: 4,
				dottedLine: true
			} as MapPolyline
		]
	})

	onLoad((query : OnLoadOptions) => {
		id.value = (query['id'] as string | null) ?? ''
		dispatchToken.value = (query['dispatchToken'] as string | null) ?? ''
		const ratioParam = (query['ratio'] as string | null) ?? ''
		if (ratioParam) {
			const parsedRatio = Number(ratioParam)
			dispatchRatio.value = isNaN(parsedRatio) ? null : parsedRatio
		} else {
			dispatchRatio.value = null
		}
		sharerId.value = (query['sharer'] as string | null) ?? ''
		isFromDispatch.value = query['from'] == 'dispatch' || dispatchToken.value !== ''

		loadMasterLocation()
		if (isFromDispatch.value && dispatchToken.value) {
			loadDispatchPreviewAndDetail()
		} else {
			loadDetail()
		}
	})

	const mapDetail = (item: any): MyOrder => {
		const serverStatus = item.status || ''
		const mappedStatus = serverStatus == 'COMPLETED'
			? 'done'
			: (serverStatus == 'ACCEPTED' || serverStatus == 'DEPARTED' || serverStatus == 'ARRIVED')
				? 'processing'
				: 'new'

		const dispatchStatus = item.isDispatch === 1
			? (item.dispatchId ? 'accepted' : 'dispatched')
			: 'none'
		const masterId = item.dispatchId || item.orderReceivingId || ''
		return {
			id: item.id,
			orderNo: item.orderNo || '-',
			createTime: item.createTime ? new Date(item.createTime).getTime() : Date.now(),
			serviceType: item.serviceType || '-',
			plateNo: item.plateNo || '-',
			status: mappedStatus,
			masterId: masterId,
			orderReceivingId: item.orderReceivingId || '',
			dispatchStatus: dispatchStatus,
			dispatchToName: item.dispatchId || '',
			orderPrice: item.price ? Number(item.price) : 0,
			ratio: item.ratio ?? null,
			remark: item.remark || '',
			customerPhone: item.customerPhone || '-',
			customerName: item.customerName || '',
			address: item.address || '',
			lat: item.lat || 0,
			lng: item.lng || 0,
			agencyId: item.agencyId || '',
			images: [],
			feedbackImages: [],
			serverStatus: serverStatus
		}
	}

	type ReverseGeocodeResponse = {
		result?: {
			address?: string
			formatted_addresses?: {
				recommend?: string
				rough?: string
			}
		}
	}

	const QQ_MAP_KEY = MAP_CONFIG.tencentKey

	const fetchReverseGeocode = (lat: number, lng: number, onSuccess: (addr: string) => void) => {
		if (!QQ_MAP_KEY) return
		uni.request({
			url: 'https://apis.map.qq.com/ws/geocoder/v1/',
			method: 'GET',
			data: {
				location: `${lat},${lng}`,
				key: QQ_MAP_KEY,
				get_poi: 0
			},
			success: (res) => {
				const anyRes = res as any
				const data = anyRes?.data as ReverseGeocodeResponse | null
				const addr = data?.result?.formatted_addresses?.recommend || data?.result?.address || ''
				if (addr) onSuccess(addr)
			}
		})
	}

	const resolveCustomerAddress = () => {
		if (detail.value.lat == 0 || detail.value.lng == 0) return
		fetchReverseGeocode(detail.value.lat, detail.value.lng, (addr) => {
			customerAddress.value = addr
		})
	}

	const resolveMasterAddress = () => {
		if (masterLat.value == 0 || masterLng.value == 0) return
		fetchReverseGeocode(masterLat.value, masterLng.value, (addr) => {
			masterAddress.value = addr
		})
	}

	const loadDetail = async () => {
		if (!id.value) {
			uni.showToast({ title: '订单编号缺失', icon: 'none' })
			return
		}
		try {
			const res = await getOrderDetail(id.value)
			detail.value = mapDetail(res.order)
			netPrice.value = res.netPrice != null ? Number(res.netPrice) : null
			if (dispatchRatio.value == null && res.order?.ratio != null) {
				const parsedRatio = Number(res.order.ratio)
				dispatchRatio.value = isNaN(parsedRatio) ? null : parsedRatio
			}
			resolveCustomerAddress()
		} catch (err: any) {
			const found = globalOrders.find((o : MyOrder) : boolean => o.id === id.value)
			if (found != null) {
				detail.value = found
				resolveCustomerAddress()
				return
			}
			uni.showToast({ title: err?.message ? String(err.message) : '未找到订单信息', icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
		}
	}

	const checkAndShowDispatchModal = () => {
		const ratio = dispatchRatio.value != null ? dispatchRatio.value : 0
		const finalAmount = detail.value.orderPrice * (1 - ratio / 100)
		const amountText = dispatchMasterIncomeAmount.value != null
			? `¥${Number(dispatchMasterIncomeAmount.value).toFixed(2)}`
			: (netPrice.value != null
				? `¥${Number(netPrice.value).toFixed(2)}`
				: `¥${finalAmount.toFixed(2)}`)

		uni.showModal({
			title: '收到派单邀请',
			content: `您收到一笔来自服务商的派单\n师傅可得金额：${amountText}\n是否接受该订单？`,
			confirmText: '立即接单',
			cancelText: '暂不处理',
			success: (res) => {
				if (res.confirm) {
					accept()
				}
			}
		})
	}

	const loadDispatchPreviewAndDetail = async () => {
		if (!dispatchToken.value) {
			await loadDetail()
			return
		}
		try {
			const preview = await getDispatchPreview(dispatchToken.value)
			if (preview.orderId) {
				id.value = preview.orderId
			}
			dispatchMasterIncomeAmount.value = preview.masterIncomeAmount != null ? Number(preview.masterIncomeAmount) / 100 : null
			await loadDetail()
			checkAndShowDispatchModal()
		} catch (err: any) {
			uni.showToast({ title: err?.message ? String(err.message) : '派单链接已失效', icon: 'none' })
			setTimeout(() => {
				uni.switchTab({ url: '/pages/orders/orders' })
			}, 1200)
		}
	}

	const formatTime = (ts: number): string => {
		const d = new Date(ts)
		const pad = (n: number): string => (n < 10 ? '0' + n : '' + n)
		return `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
	}

	const statusText = (s: OrderStatus): string => {
		if (s === 'new') return '待接单'
		if (s === 'processing') {
			const ss = detail.value.serverStatus
			if (ss === 'DEPARTED') return '已出发'
			if (ss === 'ARRIVED') return '已到达'
			return '进行中'
		}
		return '已完成'
	}

	const statusClass = (s: OrderStatus): string => {
		if (s === 'new') return 'st-new'
		if (s === 'processing') return 'st-processing'
		return 'st-done'
	}

	type OrderServerStatus = 'ACCEPTED' | 'DEPARTED' | 'ARRIVED' | 'COMPLETED' | 'PAID' | 'CREATED' | 'CANCELLED' | ''

	const getNextStatusLabel = (status: OrderServerStatus): string => {
		if (status === 'ACCEPTED') return '确认出发'
		if (status === 'DEPARTED') return '确认到达'
		if (status === 'ARRIVED') return '完成订单'
		return ''
	}

	const getNextStatusValue = (status: OrderServerStatus): OrderServerStatus => {
		if (status === 'ACCEPTED') return 'DEPARTED'
		if (status === 'DEPARTED') return 'ARRIVED'
		if (status === 'ARRIVED') return 'COMPLETED'
		return ''
	}

	const actionLabel = computed<string>(() => getNextStatusLabel(detail.value.serverStatus as OrderServerStatus))
	const actionDisabled = computed<boolean>(() => false)

	const callPhone = (phone: string) => {
		if (!phone || phone == '-') return
		uni.makePhoneCall({ phoneNumber: phone })
	}

	const openCustomerMap = () => {
		if (detail.value.lat == 0 || detail.value.lng == 0) return
		uni.openLocation({
			latitude: detail.value.lat,
			longitude: detail.value.lng,
			name: customerAddress.value || detail.value.address,
			address: customerAddress.value || detail.value.address
		})
	}

	const accept = async () => {
		try {
			const storedUserId = uni.getStorageSync('master_user_id') as string
			const operatorId = storedUserId || currentUserId.value
			if (!operatorId) {
				uni.showToast({ title: '请先登录', icon: 'none' })
				return
			}
			let data
			if (dispatchToken.value) {
				data = await acceptDispatch(dispatchToken.value, operatorId)
			} else {
				data = await acceptOrder({ orderId: detail.value.id, operatorId })
			}
			detail.value = mapDetail(data)
			uni.showToast({ title: '接单成功', icon: 'success' })
			uni.switchTab({ url: '/pages/orders/orders' })
		} catch (err: any) {
			uni.showToast({ title: err?.message ? String(err.message) : '接单失败', icon: 'none' })
		}
	}

	const applyTransfer = async () => {
		uni.showModal({
			title: '申请转派',
			content: '确定要申请转派吗？申请后订单将从您的列表中移除。',
			editable: true,
			placeholderText: '请输入转派原因',
			success: (res) => {
				if (res.confirm) {
					uni.showLoading({ title: '提交中...' })
					setTimeout(() => {
						uni.hideLoading()
						// 修改全局数据状态
						const idx = globalOrders.findIndex((o : MyOrder) : boolean => o.id === detail.value.id)
						if (idx >= 0) {
							globalOrders[idx].masterId = ''
							globalOrders[idx].isTransferPending = true
							globalOrders[idx].transferReason = res.content
						}
						uni.showToast({ title: '已提交申请', icon: 'success' })
						setTimeout(() => {
							uni.navigateBack()
						}, 1500)
					}, 1000)
				}
			}
		})
	}

	const revokeDispatch = async () => {
		try {
			const storedUserId = uni.getStorageSync('master_user_id') as string
			const operatorId = storedUserId || currentUserId.value
			if (!operatorId) {
				uni.showToast({ title: '请先登录', icon: 'none' })
				return
			}
			const data = await revokeDispatchApi(detail.value.id, operatorId)
			detail.value = mapDetail(data)
			uni.showToast({ title: '已撤回', icon: 'success' })
		} catch (err: any) {
			uni.showToast({ title: err?.message ? String(err.message) : '撤回失败', icon: 'none' })
		}
	}


	const updateStatus = async (nextStatus: OrderServerStatus) => {
		try {
			const storedUserId = uni.getStorageSync('master_user_id') as string
			const operatorId = storedUserId || currentUserId.value
			if (!operatorId) {
				uni.showToast({ title: '请先登录', icon: 'none' })
				return
			}
			let data
			if (nextStatus === 'COMPLETED') {
				data = await completeOrder(detail.value.id, operatorId)
			} else {
				data = await updateOrderStatus({ orderId: detail.value.id, status: nextStatus, operatorId })
			}
			detail.value = mapDetail(data)
			uni.showToast({ title: '状态已更新', icon: 'success' })
			if (nextStatus === 'COMPLETED') {
				uni.$emit('wallet:refresh')
			}
		} catch (err: any) {
			uni.showToast({ title: err?.message ? String(err.message) : '更新状态失败', icon: 'none' })
		}
	}

	const handleStatusAction = async () => {
		const current = detail.value.serverStatus as OrderServerStatus
		const nextStatus = getNextStatusValue(current)
		if (!nextStatus) return
		await updateStatus(nextStatus)
	}

	const onStatusActionClick = () => {
		if (!actionLabel.value || actionDisabled.value) {
			return
		}
		uni.showModal({
			title: '确认操作',
			content: `确定要执行「${actionLabel.value}」吗？`,
			confirmText: '确定',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					handleStatusAction()
				}
			}
		})
	}

	const onApplyTransferClick = () => {
		uni.showModal({
			title: '确认转派',
			content: '确定要申请转派吗？申请后订单将从您的列表中移除。',
			confirmText: '确认申请',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					applyTransfer()
				}
			}
		})
	}

	const onRevokeDispatchClick = () => {
		uni.showModal({
			title: '确认撤回',
			content: '确定要撤回该订单的派发吗？',
			confirmText: '确认撤回',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					revokeDispatch()
				}
			}
		})
	}

	const loadMasterLocation = () => {
		uni.getLocation({
			type: 'gcj02',
			success: (res) => {
				masterLat.value = res.latitude
				masterLng.value = res.longitude
				resolveMasterAddress()
			},
			fail: () => {
				masterLat.value = 0
				masterLng.value = 0
				masterAddress.value = ''
			}
		})
	}
</script>

<style>
/* 基础布局 */
.page {
	padding: 40rpx;
	background-color: #F5F7FA;
	min-height: 100vh;
}

/* 卡片容器 */
.card {
	background: #FFFFFF;
	border-radius: 24rpx;
	padding: 48rpx;
	margin-bottom: 40rpx;
	box-shadow: 0 8rpx 32rpx rgba(0, 127, 255, 0.05);
	border: 1rpx solid #E1E8ED;
}

.section-title {
	font-size: 24rpx;
	font-weight: 600;
	color: #007fff;
	text-transform: uppercase;
	letter-spacing: 1.5rpx;
	display: block;
	margin-bottom: 40rpx;
}

/* 顶部状态 */
.top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 48rpx;
	padding-bottom: 32rpx;
	border-bottom: 1rpx solid #F0F5F9;
}

.order-no {
	font-size: 28rpx;
	color: #1D1D1F;
	font-weight: 600;
	font-family: ui-monospace, monospace;
}

.status {
	font-size: 22rpx;
	padding: 8rpx 20rpx;
	border-radius: 8rpx;
	font-weight: 600;
	letter-spacing: 1rpx;
}

.st-new {
	background: #FFF9E6;
	color: #ffbe0b;
}

.st-processing {
	background: #EBF3FF;
	color: #007fff;
}

.st-done {
	background: #E6F7ED;
	color: #2ecc71;
}

/* 信息行 */
.row {
	margin-top: 24rpx;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	gap: 24rpx;
}

.label {
	width: 140rpx;
	flex-shrink: 0;
	font-size: 24rpx;
	color: #86868B;
	letter-spacing: 0.5rpx;
}

.value {
	flex: 1;
	font-size: 28rpx;
	color: #1D1D1F;
	text-align: right;
	word-break: break-all;
	line-height: 1.5;
}

.link {
	color: #007fff;
	text-decoration: none;
	font-weight: 600;
}

.highlight-blue {
	color: #007fff;
	font-weight: 600;
}

.highlight-red {
	color: #fb5607;
	font-weight: 700;
	font-size: 32rpx;
}

.muted {
	color: #D1D1D6;
}

.divider {
	height: 1rpx;
	background: #F0F5F9;
	margin: 40rpx 0;
}

/* 底部操作 */
.actions {
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}

.btn {
	width: 100%;
	height: 96rpx;
	line-height: 96rpx;
	border-radius: 12rpx;
	font-size: 28rpx;
	font-weight: 600;
	margin: 0;
	transition: all 0.2s;
}

.btn-primary {
	background: #007fff;
	color: #FFFFFF;
	border: none;
	box-shadow: 0 8rpx 20rpx rgba(0, 127, 255, 0.2);
}

.btn-success {
	background: #007fff;
	color: #FFFFFF;
	border: none;
	box-shadow: none;
}

.btn-success:disabled {
	background: #AEAEB2;
	opacity: 0.6;
	box-shadow: none;
}

.btn-transfer {
	background: #FFFFFF;
	color: #fb5607;
	border: 1rpx solid #fb5607;
}

.btn-revoke-dispatch {
	background: #FFFFFF;
	color: #FF3B30;
	border: 1rpx solid #FF3B30;
}

.btn-plain {
	background: #FFFFFF;
	color: #007fff;
	border: 1rpx solid #007fff;
}

.btn:active {
	opacity: 0.8;
}

/* 师傅反馈板块样式 */
.feedback-content {
	margin-top: 20rpx;
}

.feedback-label {
	font-size: 24rpx;
	color: #86868B;
	margin-bottom: 24rpx;
	display: block;
}

.feedback-imgs {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 20rpx;
}

.feedback-img-wrap {
	position: relative;
	width: 150rpx;
	height: 150rpx;
}

.feedback-img {
	width: 100%;
	height: 100%;
	border-radius: 12rpx;
	background: #F5F7FA;
	border: 1rpx solid #E1E8ED;
}

.img-delete {
	position: absolute;
	top: -10rpx;
	right: -10rpx;
	width: 36rpx;
	height: 36rpx;
	background: #fb5607;
	border-radius: 18rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
}

.delete-icon {
	color: #FFFFFF;
	font-size: 24rpx;
	line-height: 1;
	font-weight: bold;
}

.upload-btn {
	width: 150rpx;
	height: 150rpx;
	background: #FFFFFF;
	border: 2rpx dashed #007fff;
	border-radius: 12rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.upload-icon {
	font-size: 48rpx;
	color: #007fff;
	margin-bottom: 4rpx;
}

.upload-text {
	font-size: 20rpx;
	color: #007fff;
	font-weight: 500;
}

/* 地图板块 */
.map {
	width: 100%;
	height: 480rpx;
	border-radius: 12rpx;
	overflow: hidden;
	background: #F5F7FA;
	border: 1rpx solid #E1E8ED;
}

.loc-grid {
	margin-top: 40rpx;
	display: flex;
	flex-direction: row;
	gap: 20rpx;
}

.loc-item {
	flex: 1;
	background: #F5F7FA;
	border-radius: 12rpx;
	padding: 24rpx;
	border: 1rpx solid #E1E8ED;
}

.loc-title {
	font-size: 20rpx;
	color: #007fff;
	text-transform: uppercase;
	letter-spacing: 1rpx;
	display: block;
	margin-bottom: 8rpx;
	font-weight: 600;
}

.loc-value {
	font-size: 24rpx;
	color: #1D1D1F;
	display: block;
	word-break: break-all;
}

.loc-sub {
	font-size: 22rpx;
	color: #86868B;
