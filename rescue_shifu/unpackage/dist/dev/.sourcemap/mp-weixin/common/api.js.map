export const API_CONFIG = {
	baseURL: 'http://127.0.0.1:8080',
	timeout: 10000
}

export const MAP_CONFIG = {
	tencentKey: 'REDACTED_TENCENT_MAP_KEY'
}

export const LOGIN_URL = `${API_CONFIG.baseURL}/api/wechat/login`

interface RequestOptions {
	url: string
	method?: string
	data?: any
	header?: any
}

const request = (options: RequestOptions): Promise<any> => {
	return new Promise((resolve, reject) => {
		const fullUrl = options.url.startsWith('http')
			? options.url
			: `${API_CONFIG.baseURL}${options.url}`
		const token = uni.getStorageSync('master_token') as string

		uni.request({
			url: fullUrl,
			method: options.method || 'GET',
			data: options.data || {},
			header: {
				'content-type': 'application/json',
				...(token ? { Authorization: `Bearer ${token}` } : {}),
				...(options.header || {})
			},
			timeout: API_CONFIG.timeout,
			success: (res) => {
				if (res.statusCode === 200) {
					resolve(res.data)
				} else {
					reject(new Error(`请求失败: ${res.statusCode}`))
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

const isApiSuccess = (res: any): boolean => {
	if (res?.success === true) return true
	const code = String(res?.code ?? '')
	return code === '200' || code === '00000'
}

const apiMessage = (res: any, fallback: string): string => {
	const msg = res?.message || res?.msg
	return msg ? String(msg) : fallback
}

const unwrapData = <T>(res: any, fallback: string): T => {
	if (isApiSuccess(res)) {
		return (res?.data || {}) as T
	}
	const err: any = new Error(apiMessage(res, fallback))
	err.code = res?.code
	throw err
}

export type ShifuHallOrderRaw = {
	id: string
	address?: string
	agencyId?: string
	agencyOrderType?: number
	appointmentTime?: string
	customerId?: string
	customerName?: string
	customerPhone?: string
	isDeleted?: number
	lat?: number
	lng?: number
	orderNo?: string
	orderType?: number
	plateNo?: string
	price?: number
	ratio?: number
	remark?: string
	serviceType?: string
	status?: string
	createTime?: string
	netPrice?: number
	masterIncomeAmount?: number
	providerIncomeAmount?: number
	isDispatch?: number
	dispatchId?: string
	dispatchToken?: string
	settlementStatus?: string
	orderReceivingId?: string
}

export type ShifuHallOrderItem = {
	order: ShifuHallOrderRaw
	netPrice?: number
}

interface ShifuHallOrdersParams {
	userId: string
	lat: number
	lng: number
	radiusKm?: number
	visibleStatuses?: string
	excludeStatus?: string
}

export const getShifuHallOrders = (params: ShifuHallOrdersParams): Promise<ShifuHallOrderItem[]> => {
	return request({
		url: '/api/shifu/orders/hall',
		method: 'GET',
		data: params
	}).then((res: any) => {
		const data = unwrapData<any[]>(res, '加载订单列表失败')
		if (!Array.isArray(data)) {
			throw new Error('加载订单列表失败')
		}
		return data.map((it: any) => {
			return {
				order: it?.order as ShifuHallOrderRaw,
				netPrice: it?.netPrice != null ? Number(it.netPrice) : undefined
			} as ShifuHallOrderItem
		})
	})
}

export type OrderDetailRaw = ShifuHallOrderRaw

export type OrderDetailResp = {
	order: OrderDetailRaw
	netPrice?: number
}

export const getOrderDetail = (orderId: string): Promise<OrderDetailResp> => {
	return request({
		url: '/api/shifu/orders/detail',
		method: 'GET',
		data: { orderId }
	}).then((res: any) => {
		const data = unwrapData<any>(res, '加载订单详情失败')
		if (!data?.order) {
			throw new Error('加载订单详情失败')
		}
		return {
			order: data.order as OrderDetailRaw,
			netPrice: data.netPrice != null ? Number(data.netPrice) : undefined
		} as OrderDetailResp
	})
}

